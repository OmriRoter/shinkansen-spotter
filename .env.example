# Bright Data Web Unlocker credentials (this is exactly what the "Bright Data MCP" wraps).
# Get them at https://brightdata.com → Account settings / Proxies & Scraping → Web Unlocker zone.
# Copy this file to .env and fill in. Without it the app runs in simulation mode.

BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=web_unlocker1

# Optional
PORT=8080
